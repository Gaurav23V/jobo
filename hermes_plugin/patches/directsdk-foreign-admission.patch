+def foreign_request(payload, system):
+    """Whether native sent this request for itself rather than for the turn Hermes queried.
+
+    Claude Code 2.1.299 also names the session from the first user message in -p mode (its own
+    "You are naming a coding session" system prompt, a ``{"title"}`` JSON schema), through the same
+    base URL and in a race with the turn. Admitting it spent the single admission on the title, and
+    its ``{"title": ...}`` answer replaced the model's reply. The turn always carries Hermes'
+    system prompt (--system-prompt-file) as a system block; a request whose system text lacks it is
+    native's own. A payload that does not parse, or has no system, is not judged (forwarded as before)."""
+    system = (system or '').strip()
+    if not system:
+        return False
+    try:
+        sent = json.loads(payload).get('system')
+    except (ValueError, AttributeError):
+        return False
+    if not sent:
+        return False
+    texts = [sent] if isinstance(sent, str) else [b.get('text', '') for b in sent if isinstance(b, dict)] if isinstance(sent, list) else []
+    return not any(isinstance(t, str) and system in t for t in texts) and system not in '\n'.join(t for t in texts if isinstance(t, str))
+
