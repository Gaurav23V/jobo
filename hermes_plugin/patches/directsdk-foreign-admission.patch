+"""Native's own side requests (session titles) never spend the turn's single admission."""
+import json
+import os
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+import sys
+import threading
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import directsdk
+from admission import foreign_request
+
+# Claude Code 2.1.299 in -p mode: a title request with its own system prompt, raced ahead of the turn.
+NATIVE = r'''
+import json, os, sys, urllib.request, urllib.error
+for line in sys.stdin:
+    frame=json.loads(line)
+    if frame.get('shouldQuery') is False:
+        print(json.dumps({'type':'result','num_turns':0}),flush=True)
+        continue
+    break
+system=open(sys.argv[sys.argv.index('--system-prompt-file')+1]).read()
+url=os.environ['ANTHROPIC_BASE_URL']+'/v1/messages'
+def post(body):
+    try:
+        return urllib.request.urlopen(urllib.request.Request(url,data=json.dumps(body).encode(),headers={'Content-Type':'application/json'}),timeout=5).status
+    except urllib.error.HTTPError as e:
+        return e.code
+title=post({'system':[{'type':'text','text':'You are naming a coding session'}],'messages':[{'role':'user','content':'<session>x</session>'}],
+            'output_config':{'format':{'type':'json_schema','schema':{'type':'object','properties':{'title':{'type':'string'}}}}}})
+print(json.dumps({'type':'title_status','status':title}),file=sys.stderr)
+post({'system':[{'type':'text','text':'billing'},{'type':'text','text':system}],'messages':[{'role':'user','content':'fixture'}]})
+print(json.dumps({'type':'assistant','message':{'id':'native','role':'assistant','content':[{'type':'text','text':'NATIVE'}]}}))
+print(json.dumps({'type':'stream_event','event':{'type':'message_stop'}}))
+print(json.dumps({'type':'result','subtype':'success','usage':{'input_tokens':0,'output_tokens':0}}))
+'''
+
+
+def test_title_request_is_refused_and_turn_admitted(tmp_path):
+    calls = []
+    usage = {'input_tokens':0, 'output_tokens':0, 'cache_read_input_tokens':0, 'cache_creation_input_tokens':0}
+    class Peer(BaseHTTPRequestHandler):
+        def log_message(self, *args): pass
+        def do_POST(self):
+            body = json.loads(self.rfile.read(int(self.headers['Content-Length'])))
+            calls.append(body)
+            text = '{"title":"Fixture"}' if 'naming' in json.dumps(body['system']) else 'PONG'
+            self.send_response(200); self.send_header('Content-Type','text/event-stream'); self.end_headers()
+            events = [
+                {'type':'message_start','message':{'id':'up','role':'assistant','model':'sonnet','content':[], 'usage':usage}},
+                {'type':'content_block_start','index':0,'content_block':{'type':'text','text':''}},
+                {'type':'content_block_delta','index':0,'delta':{'type':'text_delta','text':text}},
+                {'type':'content_block_stop','index':0},
+                {'type':'message_delta','delta':{'stop_reason':'end_turn'},'usage':usage},
+                {'type':'message_stop'},
+            ]
+            self.wfile.write(''.join('data: '+json.dumps(e)+'\n\n' for e in events).encode())
+    peer = ThreadingHTTPServer(('127.0.0.1',0), Peer)
+    thread = threading.Thread(target=peer.serve_forever, daemon=True); thread.start()
+    native = tmp_path/'native.py'; native.write_text(NATIVE)
+    client = directsdk.Client(command=[sys.executable,str(native)], env={'PATH':os.defpath,'HOME':str(tmp_path),'ANTHROPIC_BASE_URL':f'http://127.0.0.1:{peer.server_port}'})
+    try:
+        result = client.create(model='sonnet', messages=[{'role':'system','content':'You are the jobo apply agent.'},{'role':'user','content':'fixture'}])
+        assert result.choices[0].message.content == 'PONG'
+        assert len(calls) == 1 and 'jobo apply agent' in json.dumps(calls[0]['system'])
+    finally:
+        client.close(); peer.shutdown(); thread.join(); peer.server_close()
+
+
+def test_foreign_request_rules():
+    turn = json.dumps({'system':[{'type':'text','text':'billing'},{'type':'text','text':'Hermes prompt\n'}]})
+    title = json.dumps({'system':[{'type':'text','text':'You are naming a coding session'}]})
+    assert not foreign_request(turn, 'Hermes prompt')
+    assert foreign_request(title, 'Hermes prompt')
+    assert not foreign_request(json.dumps({'system':'Hermes prompt'}), 'Hermes prompt')
+    # Not judged: no Hermes system, no native system, or a payload that does not parse.
+    assert not foreign_request(title, '')
+    assert not foreign_request(b'{}', 'Hermes prompt')
+    assert not foreign_request(b'not json', 'Hermes prompt')
