# Gmail API OAuth 2.0 Credentials
# Get these from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here

# Optional: Path to store OAuth tokens (defaults to credentials/token.json)
# TOKEN_PATH=credentials/token.json

# Module 2 – optional vanilla Playwright login (do not commit real values)
# Prefer CDP or persistent Chromium profile when possible; 2FA/CAPTCHA may block automation.
# JOBO_LINKEDIN_EMAIL=
# JOBO_LINKEDIN_PASSWORD=

# Module 2 – Playwright (optional; see docs/module2_implementation.md)
# JOBO_PLAYWRIGHT_CDP_URL=http://127.0.0.1:9222
# JOBO_PLAYWRIGHT_USER_DATA_DIR=/path/to/chromium-profile
# JOBO_PLAYWRIGHT_HEADLESS=0
# JOBO_ENRICH_DELAY_MS_MAX=2500 optional max jitter between job URLs (ms)

# Module 2 – parallel enrichment (producer-consumer)
# JOBO_ENRICH_WORKERS=3      worker threads calling Ollama; scrape stays single-browser
# OLLAMA_NUM_PARALLEL=3      set when STARTING the ollama server for true concurrent slots

# Module 2 – Ollama (local LLM)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b   # small model is enough for extraction; 12B+ may exhaust RAM

# Module 3 – LLM / jobo triage (see docs/module3_overview.md)
# Requires the `claude` CLI (Claude Code) on PATH, logged in (or `hermes` if JOBO_LLM_BACKEND=hermes).
# JOBO_LLM_BACKEND=claude     # claude (default: direct `claude -p`) or hermes (old path)
# JOBO_CLAUDE_MODEL=sonnet    # model for triage calls
# JOBO_CLAUDE_FIT_MODEL=      # optional cheaper model for fit scoring only (e.g. haiku)
# JOBO_CLAUDE_EFFORT=low      # --effort for triage calls
# JOBO_CLAUDE_TIMEOUT_SEC=300 # per-call timeout
# JOBO_TRIAGE_WORKERS=12      # parallel LLM processes for the fit phase (12 max before 429s)
# JOBO_HERMES_REASONING=low   # hermes backend only: reasoning effort per call
# JOBO_HERMES_TIMEOUT_SEC=300 # hermes backend only: per-call timeout
# JOBO_MIN_FIT_SCORE=3
# JOBO_PROFILE_CONTEXT_PATH=personal/profile.md
# JOBO_BASE_RESUME_TEX=/path/to/base_resume.tex
# JOBO_DEFAULT_RESUME_PDF=/path/to/base_resume.pdf
# JOBO_ARTIFACTS_DIR=data/module3/artifacts

# Module 4 – autonomous submission via Hermes browser agent (jobo apply)
# Requires: hermes CLI, agent-browser (in ~/.hermes/node/bin), a signed-in
# browser profile at $HOME/jobo-linkedin-profile, and DISPLAY/XAUTHORITY
# for the headed browser.
# JOBO_APPLY_DELAY_SEC=30     # base seconds between jobs
# JOBO_APPLY_JITTER_SEC=15    # extra random 0..N seconds
# JOBO_APPLY_MAX_JOBS=0       # cap per run (0 = unlimited)
# JOBO_APPLY_REASONING=medium # agent reasoning effort
# JOBO_APPLY_MAX_TURNS=60     # agent turns per job
# JOBO_BROWSER_PROFILE=$HOME/jobo-linkedin-profile

# Usage limits (./setup.sh asks; module4/budget_guard.py reads them). Runs stop
# at this share of the 5-hour Claude session / of the weekly allowance.
# JOBO_SESSION_THRESHOLD=0.30
# JOBO_BUDGET_THRESHOLD=0.50
