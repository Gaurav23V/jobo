+"""Regression contracts for timeout ownership, action budgets and console errors."""
+import json
+from unittest.mock import Mock
+
+import pytest
+from tools import browser_tool as bt, browser_tool_session as session
+from tools import browser_tool_handoff as handoff, browser_tool_snapshot as snapshots
+
+
+def test_timeout_replacement_cannot_inherit_readiness_or_stale_saved_target(tmp_path, monkeypatch):
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    info = {'session_name': 'old', 'cdp_url': 'ws://fixture/browser', 'features': {'cdp_override': True}}
+    monkeypatch.setattr(handoff, '_capture_target', lambda *a: 'previous-page')
+    restore = Mock()
+    monkeypatch.setattr(handoff, '_restore_target', restore)
+    monkeypatch.setattr(session._cdp, '_stop_cdp_supervisor', lambda *a: None)
+    monkeypatch.setattr(bt, '_active_sessions', {'review-timeout': info})
+    with handoff.bind_owner('review-timeout', 'durable-owner'):
+        handoff.prepare('review-timeout', info, 'open', None)
+        handoff.save('review-timeout', info, None)
+        session._discard_timed_out_browser_session('review-timeout', info, str(tmp_path / 'sockets'))
+        replacement = bt._active_sessions['review-timeout']
+        assert not replacement.get('_page_binding_ready')
+        with pytest.raises(RuntimeError):
+            handoff.prepare('review-timeout', replacement, 'snapshot', None)
+    # A clean process must not restore the checkpoint from BEFORE the timeout.
+    with handoff.bind_owner('fresh-task', 'durable-owner'):
+        fresh = {'cdp_url': info['cdp_url'], 'features': info['features']}
+        path = handoff._binding_path('fresh-task', fresh)
+        assert path == info['_page_handoff_path'], (path, info)
+        assert json.loads(path.read_text())['target_id'] is None
+        with pytest.raises(RuntimeError):
+            handoff.prepare('fresh-task', fresh, 'snapshot', None)
+    restore.assert_not_called()
+
+
+@pytest.mark.parametrize('role', ['menuitem', 'menuitemcheckbox', 'menuitemradio', 'tab', 'treeitem', 'listbox', 'gridcell', 'custom-control'])
+def test_all_ref_controls_take_priority_over_prose(role):
+    lines = ['- paragraph: prose'] * 10 + [f'- {role} "Choose" [ref=e1]', '- tab "Details" [ref=e2]']
+    out = snapshots._compact_snapshot_lines(lines, 180)
+    assert lines[-2] in out and lines[-1] in out
+    assert sum(len(line) + 1 for line in out) <= 180
+
+
+@pytest.mark.parametrize('failed_command', ['console', 'errors'])
+def test_console_without_expression_propagates_backend_errors(monkeypatch, failed_command):
+    monkeypatch.setattr(bt, '_is_camofox_mode', lambda: False)
+    monkeypatch.setattr(bt, '_blocked_private_page_content', lambda _: None)
+    def run(task, command, args):
+        return {'success': False, 'error': 'Saved browser page is unavailable'} if command == failed_command else {'success': True, 'data': {}}
+    monkeypatch.setattr(session, '_run_browser_command', run)
+    out = json.loads(bt.registry.get_entry('browser_console').handler({}, task_id='review', session_id='owner'))
+    assert not out['success']
+    assert 'Saved browser page is unavailable' in out['error']
+
+
+def test_partial_marker_eval_failure_still_removes_marker():
+    calls = []
+    def run(command, args):
+        calls.append(args[0])
+        return {'success': args[0].startswith('delete '), 'data': {'result': True}}
+    with pytest.raises(RuntimeError):
+        handoff._capture_target('unused', run)
+    assert len(calls) == 2 and calls[-1].startswith('delete ')
