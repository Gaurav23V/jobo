+"""Real Hermes tools/backend across fresh processes, isolated Chromium + fake ATS.
+
+Run with the CLI venv's Python, from this worktree. No model/API/production browser.
+"""
+import contextlib
+import http.server
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+import urllib.request
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT))
+TASK = f'isolated-live-task-{os.getpid()}'
+OWNER = 'isolated-live-resume'
+
+
+@contextlib.contextmanager
+def cdp_client(endpoint):
+    from websockets.sync.client import connect
+    version = json.load(urllib.request.urlopen(endpoint + '/json/version'))
+    with connect(version['webSocketDebuggerUrl']) as ws:
+        seq = 0
+        def cdp(method, params=None):
+            nonlocal seq
+            seq += 1
+            ws.send(json.dumps({'id': seq, 'method': method, 'params': params or {}}))
+            while True:
+                msg = json.loads(ws.recv())
+                if msg.get('id') == seq:
+                    assert 'error' not in msg, msg
+                    return msg['result']
+        yield cdp
+
+
+def child(stage, base):
+    from tools import browser_tool as bt, browser_tool_session as session
+    from tools import browser_tool_handoff as handoff
+    global OWNER
+    if stage.startswith('timeout'):
+        OWNER = 'isolated-timeout-owner'
+    def call(fn, **kwargs):
+        entry = bt.registry.get_entry(fn.__name__)
+        out = json.loads(entry.handler(kwargs, task_id=TASK, session_id=OWNER))
+        print(fn.__name__, json.dumps(out)[:1500], flush=True)
+        assert out.get('success'), out
+        return out
+    def command(cmd, args):
+        out = session._run_browser_command(TASK, cmd, args)
+        assert out['success'], out
+        return out['data']
+    if stage == 'timeout':
+        call(bt.browser_snapshot, full=True)
+        info = session._get_session_info(TASK)
+        handoff.save(TASK, info, lambda cmd, args: session._run_browser_command(TASK, cmd, args))
+        assert json.loads(info['_page_handoff_path'].read_text())['target_id']
+        session._discard_timed_out_browser_session(TASK, info, session._prepare_session_socket_dir(info['session_name']))
+    if stage in ('closed', 'timeout', 'timeout-resume'):
+        for name, args in [('browser_snapshot', {}), ('browser_console', {}), ('browser_console', {'expression': 'document.title'})]:
+            out = json.loads(bt.registry.get_entry(name).handler(args, task_id=TASK, session_id=OWNER))
+            print('closed target', name, out, flush=True)
+            assert not out['success'], out
+        print('PASS missing exact target fails closed for snapshot and console; duplicate not substituted', flush=True)
+        return
+    if stage == 'first':
+        first = call(bt.browser_navigate, url=base + '/linkedin')
+        ref = re.search(r'link "Apply" \[ref=(e\d+)\]', first['snapshot']).group(1)
+        call(bt.browser_click, ref=ref)
+        deadline = time.monotonic() + 10
+        while True:
+            snap = call(bt.browser_snapshot, full=True)
+            if 'Fake Greenhouse' in snap['snapshot']:
+                break
+            assert time.monotonic() < deadline
+            time.sleep(.1)
+        assert 'frame_tree' not in snap, snap
+        assert re.search(r'option "Chosen country" \[selected[,\]]', snap['snapshot']), snap
+        for label in ('Last name', 'Country', 'Chosen country', 'Submit application'):
+            assert label in snap['snapshot'], (label, snap)
+        assert len(snap['snapshot']) <= bt.get_browser_snapshot_threshold()
+        assert list((Path(os.environ['HERMES_HOME']) / 'cache/web').glob('browser-snapshot-*.txt'))
+        ref = re.search(r'textbox[^\n]*\[[^\]]*ref=(e\d+)\]', snap['snapshot']).group(1)
+        call(bt.browser_type, ref=ref, text='Fixture filled state')
+        original = next(t['tabId'] for t in command('tab', ['list'])['tabs'] if t['active'])
+        command('tab', ['new', base + '/form'])
+        call(bt.browser_console, expression='document.querySelector("input").value="Duplicate state"')
+        command('tab', ['new', base + '/unrelated'])
+        command('tab', [original])  # exact backend id, never match by URL
+        out = call(bt.browser_console, expression='document.querySelector("input").value')
+        assert out['result'] == 'Fixture filled state'
+    else:
+        # First tool must attach and restore without open/reload/navigation.
+        snap = call(bt.browser_snapshot, full=True)
+        assert 'Fake Greenhouse' in snap['snapshot'] and 'Fixture filled state' in snap['snapshot'], snap
+        assert 'frame_tree' not in snap, snap
+        out = call(bt.browser_console, expression='({title:document.title,url:location.href,value:document.querySelector("input").value})')
+        assert out['result'] == {'title': 'Fake Greenhouse', 'url': base + '/form', 'value': 'Fixture filled state'}
+        with cdp_client(os.environ['BROWSER_CDP_URL']) as cdp:
+            old = next(t for t in cdp('Target.getTargets')['targetInfos'] if t['url'] == base + '/linkedin')
+            cdp('Target.closeTarget', {'targetId': old['targetId']})
+        out = call(bt.browser_console, expression='document.querySelector("input").value')
+        assert out['result'] == 'Fixture filled state'
+        tabs = command('tab', ['list'])['tabs']
+        assert sum(t['url'] == base + '/form' for t in tabs) == 2
+        assert any(t['url'] == base + '/unrelated' for t in tabs)
+        print('PASS two fresh processes: snapshot + console retain exact filled form; same-URL duplicate not guessed; old-source close safe; unrelated tab preserved', flush=True)
+    print('BACKEND_SESSION', session._get_session_info(TASK)['session_name'], 'TASK', TASK, flush=True)
+    # Normal interpreter exit runs Hermes's real browser cleanup, just as CLI exit.
+
+
+def main():
+    with tempfile.TemporaryDirectory(prefix='hermes-browser-fix-live-') as directory:
+        home = Path(directory)
+        env = {'HOME': str(home), 'HERMES_HOME': str(home / 'hermes'),
+               'PATH': os.environ['PATH'], 'LANG': 'C.UTF-8',
+               'AGENT_BROWSER_EXECUTABLE_PATH': '/usr/bin/chromium'}
+        (home / 'hermes').mkdir()
+        (home / 'hermes/config.yaml').write_text('browser:\n  allow_private_urls: true\n  backend: local\n')
+        (home / 'empty-agent-browser.json').write_text('{}')
+        env['AGENT_BROWSER_CONFIG'] = str(home / 'empty-agent-browser.json')
+        requests = []
+        class Handler(http.server.BaseHTTPRequestHandler):
+            def do_GET(self):
+                requests.append(self.path)
+                if self.path == '/linkedin':
+                    body = '<title>Fake LinkedIn</title><h1>Fake LinkedIn</h1><a href="/form" target="_blank">Apply</a>'
+                elif self.path == '/form':
+                    body = ('<title>Fake Greenhouse</title><h1>Fake Greenhouse</h1>' +
+                            '<p>' + 'Experience building software. ' * 1500 + '</p>' +
+                            '<form aria-label="Application"><label>Country<select required>' +
+                            ''.join(f'<option>Country {i}</option>' for i in range(900)) +
+                            '<option selected>Chosen country</option></select></label>' +
+                            '<label>Last name (required)<input required name="last"></label>' +
+                            '<button type="button">Submit application</button></form>')
+                else:
+                    body = '<title>Unrelated tab</title><h1>Unrelated tab</h1>'
+                self.send_response(200)
+                self.send_header('Content-Type', 'text/html')
+                self.end_headers()
+                self.wfile.write(body.encode())
+            def log_message(self, *args):
+                pass
+        server = http.server.ThreadingHTTPServer(('127.0.0.1', 0), Handler)
+        threading.Thread(target=server.serve_forever, daemon=True).start()
+        base = f'http://127.0.0.1:{server.server_port}'
+        with (home / 'chromium.log').open('w') as chrome_log:
+            chrome = subprocess.Popen(['/usr/bin/chromium', '--headless=new', '--no-sandbox', '--disable-gpu',
+                                       '--disable-dev-shm-usage', '--remote-debugging-port=0',
+                                       f'--user-data-dir={home / "chrome"}', base + '/linkedin'],
+                                      env=env, stdout=chrome_log, stderr=chrome_log)
+            try:
+                port_file = home / 'chrome/DevToolsActivePort'
+                deadline = time.monotonic() + 15
+                while not port_file.exists():
+                    assert chrome.poll() is None
+                    assert time.monotonic() < deadline
+                    time.sleep(.05)
+                port = int(port_file.read_text().splitlines()[0])
+                assert port != 9333
+                env['BROWSER_CDP_URL'] = f'http://127.0.0.1:{port}'
+                names = []
+                for stage in ('first', 'resume'):
+                    result = subprocess.run([sys.executable, __file__, stage, base], env=env, cwd=ROOT,
+                                            text=True, capture_output=True, timeout=150)
+                    print(stage, 'pid exited', result.returncode, result.stdout, result.stderr, flush=True)
+                    assert result.returncode == 0, stage
+                    names.append(re.search(r'BACKEND_SESSION (\S+)', result.stdout).group(1))
+                assert names[0] != names[1], names
+                assert requests.count('/form') == 2, requests
+                print('PASS distinct fresh backend sessions; server confirms zero form renavigations on resume', names, flush=True)
+                binding = next((home / 'hermes/cache/browser-handoffs').glob('*.json'))
+                target_id = json.loads(binding.read_text())['target_id']
+                assert target_id
+                with cdp_client(env['BROWSER_CDP_URL']) as cdp:
+                    cdp('Target.closeTarget', {'targetId': target_id})
+                result = subprocess.run([sys.executable, __file__, 'closed', base], env=env, cwd=ROOT,
+                                        text=True, capture_output=True, timeout=60)
+                print(result.stdout, result.stderr, flush=True)
+                assert result.returncode == 0
+                for stage in ('timeout', 'timeout-resume'):
+                    result = subprocess.run([sys.executable, __file__, stage, base], env=env, cwd=ROOT,
+                                            text=True, capture_output=True, timeout=60)
+                    print(stage, result.stdout, result.stderr, flush=True)
+                    assert result.returncode == 0
+                assert requests.count('/form') == 2
+                with cdp_client(env['BROWSER_CDP_URL']) as cdp:
+                    targets = cdp('Target.getTargets')['targetInfos']
+                    assert any(t['url'] == base + '/form' for t in targets)
+                    assert any(t['url'] == base + '/unrelated' for t in targets)
+            finally:
+                chrome.terminate()
+                try:
+                    chrome.wait(timeout=10)
+                except subprocess.TimeoutExpired:
+                    chrome.kill()
+                    chrome.wait()
+                server.shutdown()
+
+
+if __name__ == '__main__':
+    if len(sys.argv) > 1:
+        child(sys.argv[1], sys.argv[2])
+    else:
+        main()
