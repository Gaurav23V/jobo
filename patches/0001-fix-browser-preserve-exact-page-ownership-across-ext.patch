@@ -0,0 +1,206 @@
+"""Exact external-CDP page handoff across clean Hermes process exits.
+
+agent-browser tab IDs belong to a daemon, not a browser. Save a Chrome target ID
+under the durable conversation, then map it into the fresh daemon with a temporary
+page nonce. No URL/title/order matching, daemon sharing, navigation or tab closure.
+This is a locator, NOT authority for vault fills or supervisor metadata.
+"""
+from contextlib import contextmanager
+from contextvars import ContextVar
+import hashlib
+import json
+import logging
+import time
+import uuid
+
+logger = logging.getLogger(__name__)
+_call_owner: ContextVar[tuple[str | None, str | None] | None] = ContextVar('browser_handoff_owner', default=None)
+
+
+@contextmanager
+def bind_owner(task_id, session_id):
+    """Registry-provided identity only; never inherit process-global session env."""
+    token = _call_owner.set((task_id, session_id))
+    try:
+        yield
+    finally:
+        _call_owner.reset(token)
+
+
+def _binding_path(task_id, info):
+    from hermes_constants import get_hermes_home
+
+    if not info.get('features', {}).get('cdp_override'):
+        return None
+    # Retain the established task/profile binding for cleanup after the tool's
+    # ContextVar scope has ended. Fresh CLI turns have fresh task IDs, but the
+    # dispatcher supplies the same durable session_id on --resume.
+    identity = _call_owner.get()
+    if info.get('_page_handoff_task') == task_id:
+        if identity is not None and identity != (task_id, info['_page_handoff_owner']):
+            raise RuntimeError('Browser handoff ownership mismatch')
+        return info['_page_handoff_path']
+    if not identity or not task_id or identity[0] != task_id or not identity[1]:
+        return None
+    key = hashlib.sha256(identity[1].encode()).hexdigest()
+    path = get_hermes_home() / 'cache' / 'browser-handoffs' / (key + '.json')
+    info['_page_handoff_task'] = task_id
+    info['_page_handoff_owner'] = identity[1]
+    info['_page_handoff_path'] = path
+    return path
+
+
+@contextmanager
+def _cdp_client(endpoint):
+    from websockets.sync.client import connect
+
+    with connect(endpoint, open_timeout=5, close_timeout=2) as ws:
+        seq = 0
+        def call(method, params=None, session_id=None):
+            nonlocal seq
+            seq += 1
+            message = {'id': seq, 'method': method, 'params': params or {}}
+            if session_id:
+                message['sessionId'] = session_id
+            ws.send(json.dumps(message))
+            deadline = time.monotonic() + 5
+            while True:
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    raise TimeoutError('CDP page ownership probe timed out')
+                response = json.loads(ws.recv(timeout=remaining))
+                if response.get('id') == seq:
+                    if 'error' in response:
+                        raise RuntimeError('CDP page ownership probe failed')
+                    return response.get('result', {})
+        yield call
+
+
+@contextmanager
+def _target_session(cdp, target):
+    sid = cdp('Target.attachToTarget', {'targetId': target, 'flatten': True})['sessionId']
+    try:
+        yield sid
+    finally:
+        cdp('Target.detachFromTarget', {'sessionId': sid})
+
+
+def _evaluate(cdp, sid, expression):
+    result = cdp('Runtime.evaluate', {'expression': expression, 'returnByValue': True}, sid)
+    if result.get('exceptionDetails'):
+        raise RuntimeError('CDP page ownership expression failed')
+    return result.get('result', {}).get('value')
+
+
+def _backend_value(run, expression):
+    result = run('eval', [expression])
+    if not result.get('success'):
+        raise RuntimeError('Command backend page ownership probe failed')
+    return result.get('data', {}).get('result')
+
+
+def _marker():
+    # A random non-enumerable property, deleted after the identity handshake.
+    # Using the document rather than storage avoids touching app-owned state.
+    key = json.dumps('__hermes_page_' + uuid.uuid4().hex)
+    return (f'Object.defineProperty(document, {key}, {{value: true, configurable: true}}); true',
+            f'document[{key}] === true', f'delete document[{key}]')
+
+
+def _capture_target(endpoint, run):
+    mark, probe, remove = _marker()
+    try:
+        _backend_value(run, mark)
+        with _cdp_client(endpoint) as cdp:
+            matches = []
+            for target in cdp('Target.getTargets')['targetInfos']:
+                if target.get('type') not in ('page', 'webview'):
+                    continue
+                with _target_session(cdp, target['targetId']) as sid:
+                    if _evaluate(cdp, sid, probe) is True:
+                        matches.append(target['targetId'])
+            if len(matches) != 1:
+                raise RuntimeError('Cannot prove the command backend page identity')
+            return matches[0]
+    finally:
+        _backend_value(run, remove)
+
+
+def _restore_target(endpoint, target_id, run):
+    mark, probe, remove = _marker()
+    with _cdp_client(endpoint) as cdp:
+        # attachToTarget fails for a closed target; never fall back to another.
+        with _target_session(cdp, target_id) as sid:
+            try:
+                _evaluate(cdp, sid, mark)
+                result = run('tab', ['list'])
+                if not result.get('success'):
+                    raise RuntimeError('Cannot list command backend tabs')
+                tabs = result.get('data', {}).get('tabs', [])
+                matches = []
+                for tab in tabs:
+                    tab_id = tab.get('tabId')
+                    if not isinstance(tab_id, str) or not tab_id:
+                        raise RuntimeError('Backend does not support stable tab selection')
+                    if not run('tab', [tab_id]).get('success'):
+                        raise RuntimeError('Cannot select command backend tab')
+                    if _backend_value(run, probe) is True:
+                        matches.append(tab_id)
+                if len(matches) != 1 or not run('tab', [matches[0]]).get('success'):
+                    raise RuntimeError('Cannot restore the exact application page')
+                if _backend_value(run, probe) is not True:
+                    raise RuntimeError('Application page changed during restore')
+            finally:
+                _evaluate(cdp, sid, remove)
+
+
+def invalidate(task_id, info):
+    """A timed-out command may have switched pages after the last checkpoint."""
+    info.pop('_page_binding_ready', None)
+    info['_page_binding_uncertain'] = True
+    path = _binding_path(task_id, info)
+    if path is not None:
+        from utils import atomic_json_write
+        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+        atomic_json_write(path, {'target_id': None}, mode=0o600)
+
+
+def prepare(task_id, info, command, run):
+    """Restore once per fresh daemon before ANY page command; explicit open opts out."""
+    path = _binding_path(task_id, info)
+    if path is None or command == 'close':
+        return
+    if command == 'open':
+        path.unlink(missing_ok=True)
+        info.pop('_page_binding_uncertain', None)
+        info['_page_binding_ready'] = True
+        return
+    if info.get('_page_binding_uncertain'):
+        raise RuntimeError('Saved browser page is unavailable after a timeout; navigate explicitly to choose a new page')
+    if info.get('_page_binding_ready'):
+        return
+    if path.exists():
+        saved = json.loads(path.read_text())
+        browser = hashlib.sha256(info['cdp_url'].encode()).hexdigest()
+        if saved.get('browser') != browser or not saved.get('target_id'):
+            raise RuntimeError('Saved browser page is unavailable; navigate explicitly to choose a new page')
+        _restore_target(info['cdp_url'], saved['target_id'], run)
+    info['_page_binding_ready'] = True
+
+
+def save(task_id, info, run):
+    """Checkpoint the exact page before clean daemon teardown, not on every action."""
+    path = _binding_path(task_id, info)
+    if path is None or not info.get('_page_binding_ready'):
+        return
+    from utils import atomic_json_write
+
+    saved = {'browser': hashlib.sha256(info['cdp_url'].encode()).hexdigest(), 'target_id': None}
+    try:
+        saved['target_id'] = _capture_target(info['cdp_url'], run)
+    except Exception:
+        # A tombstone is deliberate: the next process must not silently attach to
+        # the first tab when ownership could not be established at handoff.
+        logger.warning('Could not preserve exact browser page for resume', exc_info=True)
+    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+    atomic_json_write(path, saved, mode=0o600)
