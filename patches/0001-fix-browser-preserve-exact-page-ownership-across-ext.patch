+"""Oversized accessibility trees must still expose actionable controls."""
+from pathlib import Path
+
+import pytest
+from tools import browser_tool, browser_tool_snapshot as snapshots
+
+
+@pytest.mark.parametrize("form", [True, False])
+def test_oversized_snapshot_keeps_controls_and_context_inline(tmp_path, monkeypatch, form):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    prefix = ('- paragraph: Long job description.\n' * 700) + '- paragraph: ' + ('Oversized line. ' * 1500) + '\n'
+    controls = ('- group "Application":\n'
