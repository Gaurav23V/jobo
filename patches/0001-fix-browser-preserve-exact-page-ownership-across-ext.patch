+                       if len(lines[j]) < 300
+                       and re.match(r'^\s*- (text|StaticText|heading)\b', lines[j]))
+    include(sorted(context))
+    include(i for i, line in enumerate(lines) if re.match(r'^\s*- heading\b', line))
+    include(i for i, line in enumerate(lines) if re.match(r'^\s*(?:- )?option\b', line))
