+"""Durable browser handoff ownership is explicit, task/profile-scoped and fail-closed."""
+import json
+
+import pytest
+
+from tools import browser_tool as bt, browser_tool_handoff as handoff
+
+
+def test_handoff_uses_dispatch_identity_across_task_ids_not_global_env(tmp_path, monkeypatch):
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path / 'profile-a'))
+    monkeypatch.setenv('HERMES_SESSION_ID', 'unrelated-env-owner')
+    make_info = lambda: {'cdp_url': 'ws://fixture/devtools/browser/exact-instance',
+                         'features': {'cdp_override': True}}
+    captured = []
+    monkeypatch.setattr(handoff, '_capture_target', lambda *a: 'exact-target')
+    monkeypatch.setattr(handoff, '_restore_target', lambda url, target, run: captured.append((url, target)))
+    assert handoff._binding_path('unknown-task', make_info()) is None
+    first = make_info()
+    # Exercise the same registry adapter as the real native tool path.
+    monkeypatch.setattr(bt, 'browser_snapshot', lambda **kw: handoff.prepare(kw['task_id'], first, 'snapshot', None))
+    bt._fallback_call('browser_snapshot', {})({}, {'task_id': 'round-one', 'session_id': 'conversation-a'})
+    handoff.save('round-one', first, None)  # cleanup is outside the tool context
+    path = first['_page_handoff_path']
+    assert json.loads(path.read_text())['target_id'] == 'exact-target'
+    with handoff.bind_owner('round-two', 'conversation-a'):
+        handoff.prepare('round-two', make_info(), 'snapshot', None)
+    assert captured == [(first['cdp_url'], 'exact-target')]
+    with handoff.bind_owner('other-task', 'conversation-b'):
+        handoff.prepare('other-task', make_info(), 'snapshot', None)
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path / 'profile-b'))
+    with handoff.bind_owner('profile-task', 'conversation-a'):
+        handoff.prepare('profile-task', make_info(), 'snapshot', None)
+    assert len(captured) == 1  # neither a new session nor profile inherits ownership
+    assert handoff._binding_path('unknown-task', make_info()) is None
+
+
+@pytest.mark.parametrize('failure', ['capture', 'browser-replaced', 'target-closed'])
+def test_unavailable_handoff_never_runs_a_page_command_or_guesses(tmp_path, monkeypatch, failure):
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    first = {'cdp_url': 'ws://fixture/devtools/browser/one', 'features': {'cdp_override': True}}
+    def unavailable(*args):
+        raise RuntimeError('missing target')
+    monkeypatch.setattr(handoff, '_capture_target', unavailable if failure == 'capture' else lambda *a: 'exact-target')
+    monkeypatch.setattr(handoff, '_restore_target', unavailable)
+    with handoff.bind_owner('first-task', 'owner'):
+        handoff.prepare('first-task', first, 'open', None)
+    handoff.save('first-task', first, None)
+    fresh = {'cdp_url': first['cdp_url'] if failure != 'browser-replaced' else 'ws://fixture/devtools/browser/two',
+             'features': {'cdp_override': True}}
+    with handoff.bind_owner('next-task', 'owner'):
+        with pytest.raises(RuntimeError):
+            handoff.prepare('next-task', fresh, 'snapshot', lambda *a: pytest.fail('page command must not run'))
+        assert not fresh.get('_page_binding_ready')
+        # An explicit user navigation may abandon a stale binding; restore may not.
+        handoff.prepare('next-task', fresh, 'open', None)
+        assert fresh['_page_binding_ready']
+        assert not fresh['_page_handoff_path'].exists()
