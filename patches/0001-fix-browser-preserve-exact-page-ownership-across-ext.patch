+def _compact_snapshot_lines(lines: list[str], budget: int) -> list[str]:
+    """Select original lines, never regenerate refs or let prose crowd out controls.
+
+    Include structural ancestors, nearby labels/help and option children. Selection
+    is control-first, presentation stays in tree order so nesting remains meaningful.
+    """
+    role = re.compile(r'^\s*(?:- )?(textbox|combobox|checkbox|radio|spinbutton|slider|switch|searchbox|button|link|menuitem|menuitemcheckbox|menuitemradio|tab|treeitem|listbox|gridcell|scrollbar)\b')
+    indents = [len(line) - len(line.lstrip()) for line in lines]
+    parents: list[list[int]] = []
+    stack: list[int] = []
+    for i, line in enumerate(lines):
+        while stack and indents[stack[-1]] >= indents[i]:
+            stack.pop()
+        parents.append(stack.copy())
+        if line.strip():
+            stack.append(i)
+    # Options often have refs too: keep them in their selected-first budget pass.
+    controls = [i for i, line in enumerate(lines) if role.match(line) or (
+        re.search(r'\[[^\]]*\bref=', line)
+        and not re.match(r'^\s*(?:- )?option\b', line))]
+    selected: set[int] = set()
+    used = 0
+
+    def include(indices):
+        nonlocal used
+        for i in indices:
+            # A child without its ancestors can appear to belong to an entirely
+            # different group after omissions. Admit contextualized blocks only.
+            block = [j for j in parents[i] + [i] if j not in selected]
+            cost = sum(len(lines[j]) + 1 for j in block)
+            if used + cost <= budget:
+                selected.update(block)
+                used += cost
+
+    # Finish each budget pass globally. An early combobox's option subtree
+    # must not spend the budget reserved for later fields or Submit.
+    include(controls)
+    include(i for i, line in enumerate(lines)
+            if re.match(r'^\s*(?:- )?option\b', line)
+            and re.search(r'\[[^\]]*\bselected(?:=true)?(?=[,\]])', line))
+    context = set()
+    for i in controls:
