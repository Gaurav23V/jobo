+"""Review regressions: fair snapshot budget, intact nesting, no foreign metadata."""
+import json
+from unittest.mock import MagicMock
+
+import pytest
+
+from tools import browser_tool as bt, browser_tool_snapshot as snapshots
+from tools import browser_tool_session as session
+
+
+@pytest.mark.parametrize('selected', ['[selected]', '[selected, ref=e999]'])
+def test_option_flood_cannot_starve_later_controls_or_selected_option(selected):
+    lines = ['- group "Application":', '  - combobox "Country" [ref=e1]:']
+    lines += [f'    - option "Country {i}"' for i in range(900)]
+    lines += [f'    - option "Chosen country" {selected}',
+              '  - text: Last name (required)',
+              '  - textbox "Last name" [ref=e2]',
+              '  - button "Submit application" [ref=e3]']
+    out = snapshots._compact_snapshot_lines(lines, 900)
+    for line in lines[-4:]:
+        assert line in out
+    assert sum(len(line) + 1 for line in out) <= 900
+
+
+def test_budget_selection_preserves_global_tree_order_and_ancestors():
+    lines = ['- group "Before":', '  - paragraph: ' + 'Long prose. ' * 500,
+             '- group "Application":', '  - textbox "Name" [ref=e1]',
+             '  - text: Application Help', '- paragraph: Footer']
+    out = snapshots._compact_snapshot_lines(lines, 280)
+    indices = [lines.index(line) for line in out]
+    assert indices == sorted(indices)
+    assert out.index('- group "Application":') < out.index('  - text: Application Help')
+    # Its most recent equally-indented ancestor must still be Application.
+    ancestors = [line for line in out[:out.index('  - text: Application Help')] if line.startswith('- ')]
+    assert ancestors[-1] == '- group "Application":'
+
+
+@pytest.mark.parametrize('supervisor_url', ['https://old.example/start', 'https://form.example/apply'])
+def test_snapshot_omits_supervisor_metadata_without_exact_backend_identity(monkeypatch, supervisor_url):
+    from tools.browser_supervisor import SUPERVISOR_REGISTRY
+    supervisor = MagicMock()
+    supervisor.snapshot.return_value.active = True
+    supervisor.snapshot.return_value.to_dict.return_value = {
+        'frame_tree': {'top': {'url': supervisor_url}}, 'pending_dialogs': [{'id': 'foreign'}]}
+    monkeypatch.setattr(SUPERVISOR_REGISTRY, 'get', lambda _: supervisor)
+    monkeypatch.setattr(bt, '_is_camofox_mode', lambda: False)
+    monkeypatch.setattr(bt, '_blocked_private_page_content', lambda _: None)
+    monkeypatch.setattr(session, '_run_browser_command', lambda *a, **kw: {
+        'success': True, 'data': {'snapshot': '- textbox "Application" [ref=e1]', 'refs': {},
+                                 'url': 'https://form.example/apply'}})
+    out = json.loads(bt.browser_snapshot(task_id='review'))
+    assert out['success']
+    assert 'frame_tree' not in out
+    assert 'pending_dialogs' not in out
